<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- munshi tick (issue #55): fires the idempotent maintenance sweep every 15 minutes so an
     idle machine still drains retries, rescues, and park re-evaluations without a daemon.
     Paths are absolute for this machine (launchd expands no ~); adjust user paths, then:
       cp contrib/launchd/com.munshi.tick.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.munshi.tick.plist
     Remove with `launchctl bootout gui/$UID/com.munshi.tick`. The tick prints only when it
     did something, so the log stays near-empty on a healthy machine. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.munshi.tick</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/surdy/.local/bin/munshi</string>
        <string>tick</string>
    </array>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/Users/surdy/.munshi/tick.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/surdy/.munshi/tick.log</string>
</dict>
</plist>
